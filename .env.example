# 服务端口
PORT=3000

# 管理员初始账号（仅首次启动生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 上游 API Key 的加密主密钥。强烈建议自行设置（>=16 位），否则会自动生成并保存在 data/.master_key
# MASTER_KEY=please-change-this-to-a-random-string

# 后台 JWT 签名密钥，多实例部署时务必自定义
# JWT_SECRET=change-me

# SQLite 数据库路径（默认 data/gateway.db）
# DB_PATH=./data/gateway.db
